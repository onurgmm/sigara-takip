<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bilgilerini Gir - Sigara Takip Sitesi</title>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <div class="profile-menu-wrapper">
        <button id="profileIconButton" class="profile-icon-button" type="button" title="Kayıtlı Profiller">
            👤
        </button>
        <div id="profileDropdown" class="profile-dropdown hidden">
            <div class="profile-dropdown-title">Kayıtlı Profiller</div>
            <div id="profileDropdownList"></div>
        </div>
    </div>
    <div class="container">
        <div style="text-align: left; margin-bottom: 15px;">
            <a href="/" class="home-btn">← Ana Sayfaya Dön</a>
        </div>
        <h2>Bilgilerini Gir</h2>
        <form action="/save" method="POST" id="quitForm">
            <div class="form-group">
                <label for="name">İsim:</label>
                <input type="text" id="name" name="name" required placeholder="Adınız">
            </div>
            
            <div class="form-group">
                <label for="quit_date">Sigarayı Bıraktığınız Tarih:</label>
                <% 
                const today = new Date();
                const dd = String(today.getDate()).padStart(2, '0');
                const mm = String(today.getMonth() + 1).padStart(2, '0');
                const yyyy = today.getFullYear();
                const maxDate = yyyy + '-' + mm + '-' + dd;
                %>
                <input type="date" id="quit_date" name="quit_date" max="<%= maxDate %>" required>
            </div>
            
            <div class="form-group">
                <label for="daily_cigarettes">Günlük İçtiğiniz Sigara Adedi:</label>
                <input type="number" id="daily_cigarettes" name="daily_cigarettes" min="1" required placeholder="Örn: 15">
            </div>
            
            <div class="form-group">
                <label for="pack_price">Bir Paket Sigara Fiyatı (TL):</label>
                <input type="number" id="pack_price" name="pack_price" step="0.01" min="1" required placeholder="Örn: 60">
            </div>
            
            <div class="form-group">
                <label for="cigarettes_per_pack">Bir Paketteki Sigara Sayısı:</label>
                <input type="number" id="cigarettes_per_pack" name="cigarettes_per_pack" min="1" required placeholder="Örn: 20">
            </div>
            
            <button type="submit" class="btn btn-success">Kaydet ve Başla</button>
        </form>
    </div>
    
    <script src="/public/js/main.js"></script>
</body>
</html>
